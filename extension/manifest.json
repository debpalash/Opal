{
  "manifest_version": 3,
  "name": "Opal Connect",
  "version": "0.4.0",
  "description": "Send any website's media, articles and downloads to a locally-running Opal, turn manga/novel sites into Opal sources, and drive the full remote — search, transport, queue, downloads, torrents, cast and watch-party — from the side panel.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage",
    "scripting",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/*.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Open Opal panel",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "commands": {
    "opal-send-page": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Send the current page to Opal"
    },
    "opal-playpause": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Play / pause Opal"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "sidebar_action": {
    "default_panel": "src/sidepanel/index.html",
    "default_title": "Opal",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "opal-connect@opal.app",
      "strict_min_version": "115.0"
    }
  }
}
