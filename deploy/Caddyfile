# Opal behind Caddy — automatic HTTPS via Let's Encrypt.
# DOMAIN is injected from the compose environment (see docker-compose.tls.yml).
# Caddy and Opal share a network namespace. Only Caddy publishes ports;
# Opal binds loopback and emits Secure cookies in OPAL_HTTPS_PROXY mode.
# Auth is Opal's own account login — Caddy terminates TLS.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:41595
}
