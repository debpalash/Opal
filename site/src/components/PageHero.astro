---
import SiteNav from "./SiteNav.astro";

interface Props {
  current: string;
  eyebrow: string;
  title: string;
  lead: string;
}

const { current, eyebrow, title, lead } = Astro.props;
---

<header class="hero page-hero">
  <div class="veil"></div>
  <SiteNav current={current} />
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Opal</a><span aria-hidden="true">/</span><span>{eyebrow}</span>
    </nav>
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="tagline">{lead}</p>
    <slot />
  </div>
</header>
