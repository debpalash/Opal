---
import { AUTHOR_URL, REPO } from "../lib/site";

const asciiLogo = "  ___              _ \n / _ \\ _ __   __ _| |\n| | | | '_ \\ / _` | |\n| |_| | |_) | (_| | |\n \\___/| .__/ \\__,_|_|\n      |_|            ";

const columns: [string, [string, string][]][] = [
  [
    "Product",
    [
      ["/features/", "Features"],
      ["/guides/keyless-movies-tv/", "Keyless catalog guide"],
      ["/download/", "Download"],
      ["/extension/", "Opal Connect"],
      ["/changelog/", "Changelog"],
    ],
  ],
  [
    "Compare",
    [
      ["/compare/", "All apps"],
      ["/compare/jellyfin/", "vs Jellyfin"],
      ["/compare/plex/", "vs Plex"],
      ["/compare/stremio/", "vs Stremio"],
    ],
  ],
  [
    "Project",
    [
      [REPO, "GitHub"],
      [`${REPO}/issues`, "Report a bug"],
      ["/faq/", "FAQ"],
      ["/privacy/", "Privacy"],
    ],
  ],
];
---

<footer>
  <div class="wrap">
    <div class="cols">
      <div class="about">
        <a class="ascii-brand" href="/" aria-label="Opal home"><pre aria-hidden="true">{asciiLogo}</pre></a>
        <p>A free, open-source, local-first media player. One app for movies, TV, anime, live TV, torrents, manga — and your Jellyfin &amp; Plex.</p>
        <p class="follow"><a href="https://ko-fi.com/debpalash">Support on Ko-fi</a> · <a href={AUTHOR_URL} rel="me">Follow the build</a></p>
      </div>
      {
        columns.map(([title, links]) => (
          <nav aria-label={`${title} links`}>
            <p class="col-title">{title}</p>
            {links.map(([href, label]) => (
              <a href={href}>{label}</a>
            ))}
          </nav>
        ))
      }
    </div>
    <p class="legal">
      GPL-3.0. Opal hosts no content and ships with no sources enabled.<br />
      Photographs by Nareeta Martin and FLY:D, via Unsplash.
    </p>
  </div>
</footer>

<style>
  .ascii-brand {
    display: inline-block;
    max-width: 100%;
    color: var(--fg);
    text-decoration: none;
    border-radius: 4px;
  }
  .ascii-brand pre {
    margin: 0;
    padding: 0;
    background: none;
    color: inherit;
    font: 500 clamp(14px, 1.4vw, 18px) / 1.1 ui-monospace, "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    letter-spacing: -0.035em;
    white-space: pre;
  }
  .ascii-brand:hover { color: var(--accent, var(--fg)); }
  .ascii-brand:focus-visible { outline: 2px solid currentColor; outline-offset: 8px; }
</style>
