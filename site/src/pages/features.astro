---
import PageLayout from "../layouts/PageLayout.astro";
import { breadcrumbSchema, pageFor } from "../lib/site";

const page = pageFor("/features/");
const groups = [
  {
    title: "Find everything from one search",
    body: "Search local files, torrents, Jellyfin, Plex, Stremio sources, anime, YouTube, live TV and manga together. Results stay labelled by source so you always know where a result came from.",
  },
  {
    title: "Stream torrents like ordinary media",
    body: "Open a magnet link and start watching while pieces download. Opal keeps torrent discovery separate from playback and ships with no sources enabled.",
  },
  {
    title: "Bring your existing libraries",
    body: "Connect Jellyfin and Plex instead of rebuilding a library. Local files, remote libraries and web sources can appear in the same search experience.",
  },
  {
    title: "Watch live TV and web video",
    body: "Search a large IPTV catalogue, play YouTube with SponsorBlock support and use subtitles that can be fetched, synchronized and styled per file.",
  },
  {
    title: "Read manga on the desktop",
    body: "Use Mihon and Tachiyomi-compatible extensions through the bundled Suwayomi server, alongside the media you already watch and listen to.",
  },
  {
    title: "Ask a local AI copilot",
    body: "Get recommendations and ask Opal to search, queue or play without sending your watch history to an Opal account or telemetry service.",
  },
  {
    title: "Continue on another screen",
    body: "Use the LAN web interface, a phone remote or a watch party. Browser-incompatible formats can be transcoded for playback.",
  },
  {
    title: "Keep your history under your control",
    body: "Session restore and watch history live in a local SQLite database. Trakt sync is available when you deliberately connect it.",
  },
  {
    title: "Connect the browser",
    body: "Opal Connect can send the current video to Opal, add compatible sites as sources and expose playback controls from a browser side panel.",
  },
];
---

<PageLayout
  path={page.path}
  title={page.title}
  description={page.description}
  eyebrow="Features"
  heading="One media app instead of a stack"
  lead="Search, stream, read and control your media across local files, servers and sources—from one native, local-first interface."
  jsonLd={breadcrumbSchema("Features", page.path)}
>
  <section class="page-section" aria-labelledby="feature-list">
    <div class="wrap">
      <p class="eyebrow">What Opal does</p>
      <h2 id="feature-list">Built around the way media is actually scattered</h2>
      <div class="grid page-grid">
        {groups.map((group) => <article class="card"><h3>{group.title}</h3><p>{group.body}</p></article>)}
      </div>
    </div>
  </section>

  <section class="page-section alt">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Universal search</p>
        <h2>One query, clearly sourced results</h2>
        <p class="sub">Opal fans a query out to your enabled providers and ranks the responses together. Source badges and media types keep the combined result set understandable.</p>
        <a class="text-link" href="/compare/">Compare Opal with other media apps →</a>
      </div>
      <div class="shot">
        <img src="/assets/search.png" alt="Opal search results from multiple labelled media sources" width="1600" height="1032" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <section class="page-cta">
    <div class="wrap">
      <p class="eyebrow">Try it</p>
      <h2>Free, open source and ready for your libraries</h2>
      <p class="sub">Download Opal for Linux, macOS or Windows, then enable only the sources you want.</p>
      <a class="btn primary" href="/download/">Download Opal</a>
      <a class="btn" href="/faq/">Read the FAQ</a>
    </div>
  </section>
</PageLayout>
