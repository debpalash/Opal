---
import PageLayout from "../layouts/PageLayout.astro";
import { breadcrumbSchema, pageFor } from "../lib/site";

const page = pageFor("/features/");
const groups = [
  {
    title: "Find everything from one search",
    body: "One query covers local files, torrents, Jellyfin, Plex, Stremio sources, anime, YouTube, live TV and manga — every result labelled with where it came from.",
  },
  {
    title: "Stream torrents like ordinary media",
    body: "Open a magnet and start watching while the pieces download. Opal ships with no sources enabled and hosts nothing.",
  },
  {
    title: "Bring your existing libraries",
    body: "Sign in to Jellyfin and Plex and their libraries join the same search — no rebuilding, no migration.",
  },
  {
    title: "Watch live TV and web video",
    body: "A searchable IPTV catalog, YouTube with SponsorBlock, and subtitles fetched, synced and styled per file.",
  },
  {
    title: "Read manga on the desktop",
    body: "Mihon and Tachiyomi-compatible extensions through the bundled Suwayomi server, beside everything you watch.",
  },
  {
    title: "Ask a local AI copilot",
    body: "A model on your machine recommends, searches, queues and plays — no Opal account, no telemetry.",
  },
  {
    title: "Continue on another screen",
    body: "A LAN web UI, a phone remote and watch parties, with transcoding for whatever a browser can't decode.",
  },
  {
    title: "Keep your history under your control",
    body: "Session restore and watch history live in one local SQLite file; Trakt sync only when you connect it.",
  },
  {
    title: "Connect the browser",
    body: "Opal Connect sends the tab's video to Opal, adds compatible sites as sources and drives playback from a side panel.",
  },
];
---

<PageLayout
  path={page.path}
  title={page.title}
  description={page.description}
  eyebrow="Features"
  heading="One media app instead of a stack"
  lead="Search, stream and read across local files, servers and the web — from one native, local-first app."
  jsonLd={breadcrumbSchema("Features", page.path)}
>
  <section class="page-section" aria-labelledby="feature-list">
    <div class="wrap">
      <p class="eyebrow">What Opal does</p>
      <h2 id="feature-list">Built around the way media is actually scattered</h2>
      <div class="grid page-grid">
        {groups.map((group) => <article class="card"><h3>{group.title}</h3><p>{group.body}</p></article>)}
      </div>
    </div>
  </section>

  <section class="page-section alt">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Universal search</p>
        <h2>One query, clearly sourced results</h2>
        <p class="sub">A query fans out to every enabled provider and comes back as a single ranked list, badged by source.</p>
        <a class="text-link" href="/compare/">Compare Opal with other media apps →</a>
      </div>
      <div class="shot">
        <img src="/assets/search.png" alt="Opal search results from multiple labelled media sources" width="1600" height="1032" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <section class="page-cta">
    <div class="wrap">
      <p class="eyebrow">Try it</p>
      <h2>Free, open source and ready for your libraries</h2>
      <p class="sub">Download Opal for Linux, macOS or Windows, then enable only the sources you want.</p>
      <a class="btn primary" href="/download/">Download Opal</a>
      <a class="btn" href="/faq/">Read the FAQ</a>
    </div>
  </section>
</PageLayout>
