---
import PageLayout from "../layouts/PageLayout.astro";
import { breadcrumbSchema, pageFor } from "../lib/site";

const page = pageFor("/faq/");
const questions = [
  ["What is Opal?", "A free, open-source desktop media player that searches and plays across local files, torrents, Jellyfin, Plex, web video, live TV, anime and manga."],
  ["Does Opal include torrent sources?", "No. Opal ships with no sources enabled and hosts no content. You choose which compatible plugins or sources to install."],
  ["Is Opal legal?", "The app is: it's a GPL-3.0 player that, like a browser, ships with no content. Streaming copyrighted material without permission may be illegal where you live — you are responsible for the sources you add and how you use them."],
  ["Can Opal stream a torrent before it finishes?", "Yes. Playback starts while the needed pieces download, so a magnet behaves like playable media rather than a download job."],
  ["Do I need a Plex or Jellyfin server?", "No, both are optional. If you already run one, Opal signs in and folds that library into its search and playback."],
  ["Does the AI send my history to the cloud?", "The copilot runs locally, and session and watch history live in a SQLite database on your machine. Third-party services you connect still receive the requests their features need."],
  ["Does Opal work offline?", "For anything on your disk, yes — local files play with subtitles, resume and history intact. Network sources like torrents, IPTV, YouTube, Jellyfin and Plex need a connection."],
  ["Which operating systems are supported?", "Linux, macOS and Windows builds are published for every release. Windows is currently alpha, and unsigned builds can trigger OS security warnings."],
  ["How do I update Opal?", "Re-run the install one-liner — it detects your platform, verifies checksums and doubles as the updater. Every build is also on the GitHub releases page."],
  ["What does the Opal Connect extension do?", "It links Chrome, Edge or Firefox to the desktop app: send the tab's media, add compatible sites as sources, search, and control playback from a side panel."],
  ["Is Opal free and open source?", "Yes — GPL-3.0, with the full source and release history on GitHub. No account, no subscription, no telemetry."],
];
const faqSchema = {
  "@type": "FAQPage",
  mainEntity: questions.map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text },
  })),
};
---

<PageLayout
  path={page.path}
  title={page.title}
  description={page.description}
  eyebrow="FAQ"
  heading="Questions about Opal, answered"
  lead="Torrents, servers, local AI, platforms and privacy — the short answers."
  jsonLd={[breadcrumbSchema("FAQ", page.path), faqSchema]}
>
  <section class="page-section">
    <div class="wrap faq-list">
      {questions.map(([question, answer], index) => <details open={index === 0}><summary>{question}</summary><p>{answer}</p></details>)}
    </div>
  </section>
  <section class="page-cta"><div class="wrap"><h2>Ready to try it?</h2><p class="sub">Choose a package for Linux, macOS or Windows.</p><a class="btn primary" href="/download/">Download Opal</a><a class="btn" href="/privacy/">Read privacy details</a></div></section>
</PageLayout>
