---
import PageLayout from "../layouts/PageLayout.astro";
import { REPO, breadcrumbSchema, pageFor } from "../lib/site";

const page = pageFor("/compare/");
const rivals = ["Jellyfin", "Plex", "qBittorrent", "Stremio", "Kodi"];
const matrix = [
  ["One search across every source", "Yes", "Own library", "Own library", "Torrent search", "Add-ons", "Add-ons"],
  ["Play a torrent while it downloads", "Yes", "—", "—", "Download only", "Yes", "Add-ons"],
  ["Jellyfin and Plex libraries", "Both", "Its own", "Its own", "—", "Add-ons", "Add-ons"],
  ["Live TV", "Large IPTV catalog", "Tuner or M3U", "Tuner or M3U", "—", "Add-ons", "Add-ons"],
  ["Manga", "Yes", "—", "—", "—", "—", "—"],
  ["On-device AI copilot", "Yes", "—", "—", "—", "—", "—"],
  ["No server to set up", "Yes", "Needs a server", "Needs a server", "Yes", "Yes", "Yes"],
  ["No account", "Yes", "Local account", "Plex account", "Yes", "Account to sync", "Yes"],
  ["License", "GPL-3.0", "GPL-2.0", "Proprietary", "GPL-2.0+", "Partly open", "GPL-2.0+"],
];
---

<PageLayout
  path={page.path}
  title={page.title}
  description={page.description}
  eyebrow="Compare"
  heading="Opal compared with familiar media apps"
  lead="See where Opal overlaps with Jellyfin, Plex, Stremio, Kodi and qBittorrent—and where combining sources in one player changes the workflow."
  jsonLd={breadcrumbSchema("Compare", page.path)}
>
  <section class="page-section">
    <div class="wrap">
      <p class="eyebrow">Capability matrix</p>
      <h2>Different tools, different jobs</h2>
      <p class="sub">“Add-ons” means a capability is available through a third-party extension rather than maintained as a built-in feature.</p>
      <div class="tablewrap">
        <table class="matrix">
          <thead><tr><th>Capability</th><th class="me">Opal</th>{rivals.map((rival) => <th>{rival}</th>)}</tr></thead>
          <tbody>{matrix.map(([capability, ...cells]) => <tr><td>{capability}</td>{cells.map((cell, index) => <td class={`${index === 0 ? "me " : ""}${cell === "—" ? "no" : ""}`}>{cell}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="foot">Compiled from each project's documentation and licensing information. If a capability has changed, <a href={`${REPO}/issues`}>open an issue</a> so the table can be corrected.</p>
    </div>
  </section>

  <section class="page-section alt">
    <div class="wrap compare-notes">
      <article><h2>Opal vs Jellyfin or Plex</h2><p>Jellyfin and Plex organize and serve a library. Opal can connect to both while also searching local files and other enabled sources. It complements an existing server when you want one playback and discovery interface.</p></article>
      <article><h2>Opal vs Stremio or Kodi</h2><p>All three can aggregate media through extensions. Opal also includes native torrent playback, manga support, a local AI copilot and direct connections to both Jellyfin and Plex.</p></article>
      <article><h2>Opal vs qBittorrent</h2><p>qBittorrent is a dedicated BitTorrent client. Opal treats a magnet as playable media and combines torrent results with other sources, but it is not intended to replace every advanced torrent-management control.</p></article>
    </div>
  </section>

  <section class="page-cta"><div class="wrap"><h2>See the complete feature set</h2><p class="sub">Explore how search, sources, playback and local data work together.</p><a class="btn primary" href="/features/">Explore features</a><a class="btn" href="/download/">Download Opal</a></div></section>
</PageLayout>
