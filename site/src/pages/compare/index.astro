---
import PageLayout from "../../layouts/PageLayout.astro";
import { RIVALS } from "../../lib/compare";
import { REPO, breadcrumbSchema, pageFor } from "../../lib/site";

const page = pageFor("/compare/");
const rivals = ["Jellyfin", "Plex", "qBittorrent", "Stremio", "Kodi"];
const matrix = [
  ["One search across every source", "Yes", "Own library", "Own library", "Torrent search", "Add-ons", "Add-ons"],
  ["Play a torrent while it downloads", "Yes", "—", "—", "Download only", "Yes", "Add-ons"],
  ["Jellyfin and Plex libraries", "Both", "Its own", "Its own", "—", "Add-ons", "Add-ons"],
  ["Live TV", "Large IPTV catalog", "Tuner or M3U", "Tuner or M3U", "—", "Add-ons", "Add-ons"],
  ["Manga", "Yes", "—", "—", "—", "—", "—"],
  ["On-device AI copilot", "Yes", "—", "—", "—", "—", "—"],
  ["No server to set up", "Yes", "Needs a server", "Needs a server", "Yes", "Yes", "Yes"],
  ["No account", "Yes", "Local account", "Plex account", "Yes", "Account to sync", "Yes"],
  ["License", "GPL-3.0", "GPL-2.0", "Proprietary", "GPL-2.0+", "Partly open", "GPL-2.0+"],
];
---

<PageLayout
  path={page.path}
  title={page.title}
  description={page.description}
  eyebrow="Compare"
  heading="Opal, next to the apps you already run"
  lead="Where Opal overlaps with Jellyfin, Plex, Stremio, Kodi and qBittorrent — and where one player for every source changes the workflow."
  jsonLd={breadcrumbSchema("Compare", page.path)}
>
  <section class="page-section">
    <div class="wrap">
      <p class="eyebrow">Capability matrix</p>
      <h2>Different tools, different jobs</h2>
      <p class="sub">“Add-ons” means a third-party extension provides it, not the app itself.</p>
      <div class="tablewrap">
        <table class="matrix">
          <thead><tr><th>Capability</th><th class="me">Opal</th>{rivals.map((rival) => <th>{rival}</th>)}</tr></thead>
          <tbody>{matrix.map(([capability, ...cells]) => <tr><td>{capability}</td>{cells.map((cell, index) => <td class={`${index === 0 ? "me " : ""}${cell === "—" ? "no" : ""}`}>{cell}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="foot">Compiled from each project's own documentation and licenses. Something changed? <a href={`${REPO}/issues`}>Open an issue</a> and the table gets fixed.</p>
    </div>
  </section>

  <section class="page-section alt">
    <div class="wrap">
      <p class="eyebrow">Head to head</p>
      <h2>The detailed comparisons</h2>
      <p class="sub">One page per app: what each does better, and when running both makes sense.</p>
      <div class="grid page-links versus">
        {
          RIVALS.map((rival) => (
            <a class="card" href={`/compare/${rival.slug}/`}>
              <h3>Opal vs {rival.name}</h3>
              <p>{rival.lead}</p>
              <span class="text-link">Read the comparison →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-cta"><div class="wrap"><h2>See the complete feature set</h2><p class="sub">How search, sources, playback and local data fit together.</p><a class="btn primary" href="/features/">Explore features</a><a class="btn" href="/download/">Download Opal</a></div></section>
</PageLayout>
