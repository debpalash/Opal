---
// opal.palash.dev — the whole site is this one page (plus /thanks).
//
// Astro renders it to static HTML at build time; the React components below are
// islands, hydrated on load, because each of them needs the browser: the
// clipboard, the visitor's platform, and the newest release from the GitHub
// API. Everything else — copy, the photographic bands, screenshots, the
// comparison matrix — is HTML and CSS with no JavaScript attached, which is why
// the page is readable before (and without) hydration.
import "../styles/tailwind.css";
import "../styles/global.css";
import InstallCommand from "../components/InstallCommand.tsx";
import DownloadGrid from "../components/DownloadGrid.tsx";
import DownloadMenu from "../components/DownloadMenu.tsx";
import ExtensionDownloads from "../components/ExtensionDownloads.tsx";
import ReleaseBadge from "../components/ReleaseBadge.tsx";
import StarButton from "../components/StarButton.tsx";

const REPO = "https://github.com/debpalash/Opal";
const X = "https://x.com/idebpalash";

const features = [
  ["One search, every source", "Disk, torrents, Jellyfin, Plex, Stremio, anime, YouTube, live TV and manga — one ranked list."],
  ["Magnets behave like files", "Press play on a torrent and you are watching while it downloads."],
  ["An AI that lives on your machine", "A local model answers “what should I watch?” with picks you can play."],
  ["~40,000 live channels", "A full IPTV catalog, searchable as you type."],
  ["Manga on the desktop", "Mihon / Tachiyomi extensions, with the Suwayomi server bundled."],
  ["Subtitles that find themselves", "Fetched, synced and styled per file. SponsorBlock for YouTube."],
  ["Watch together", "A watch-party others can join, and a phone remote for the couch."],
  ["The same app in a browser", "A web UI on your LAN, with transcoding for anything your browser cannot decode."],
  ["Picks up where you left off", "Session restore, watch history and Trakt sync — all in a SQLite file you own."],
];

// Compiled from each project's own documentation. "Add-ons" means available
// through third-party extensions rather than built in — a real difference in
// who maintains it and whether it survives an update.
const rivals = ["Jellyfin", "Plex", "qBittorrent", "Stremio", "Kodi"];
const matrix = [
  ["One search across every source", "Yes", "Own library", "Own library", "Torrent search", "Add-ons", "Add-ons"],
  ["Play a torrent while it downloads", "Yes", "—", "—", "Download only", "Yes", "Add-ons"],
  ["Your Jellyfin and Plex libraries", "Both", "Its own", "Its own", "—", "Add-ons", "Add-ons"],
  ["Live TV", "~40,000 channels", "Tuner or M3U", "Tuner or M3U", "—", "Add-ons", "Add-ons"],
  ["Manga", "Yes", "—", "—", "—", "—", "—"],
  ["On-device AI copilot", "Yes", "—", "—", "—", "—", "—"],
  ["No server to set up", "Yes", "Needs a server", "Needs a server", "Yes", "Yes", "Yes"],
  ["No account", "Yes", "Local account", "Plex account", "Yes", "Account to sync", "Yes"],
  ["Licence", "GPL-3.0", "GPL-2.0", "Proprietary", "GPL-2.0", "Partly open", "GPL-2.0"],
];

const title = "Opal — play everything, from one app";
const description =
  "A free, open-source, local-first media player and browser. Search and stream movies, TV, anime, live TV, YouTube, torrents and manga — plus your own Jellyfin and Plex — with an on-device AI copilot. No accounts, no cloud, no subscription.";

// Structured data describes what is already on the page — nothing hidden, no
// claims the page does not make. Google drops (and can penalise) markup that
// has no visible counterpart.
const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "Opal",
      applicationCategory: "MultimediaApplication",
      operatingSystem: "macOS, Linux, Windows",
      description,
      url: "https://opal.palash.dev/",
      downloadUrl: "https://opal.palash.dev/#download",
      softwareVersion: "0.6.4",
      license: "https://www.gnu.org/licenses/gpl-3.0.html",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      author: { "@type": "Person", name: "Palash Deb", url: X },
      codeRepository: REPO,
    },
    {
      "@type": "WebSite",
      name: "Opal",
      url: "https://opal.palash.dev/",
      publisher: { "@type": "Person", name: "Palash Deb", url: X },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://opal.palash.dev/" />
    <link rel="icon" href="/assets/logo.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#05050a" />
    <!-- Every island's data comes from one host; the handshake can start now. -->
    <link rel="preconnect" href="https://api.github.com" crossorigin />
    <!-- The hero backdrop is a CSS background, so the browser only finds it
         after the stylesheet parses. Preloading pulls that forward. -->
    <link rel="preload" as="image" href="/assets/opal.jpg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Opal" />
    <meta property="og:locale" content="en" />
    <meta property="og:url" content="https://opal.palash.dev/" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="Movies, TV, anime, live TV, YouTube, torrents, manga, Jellyfin and Plex — one native app, on your machine. No accounts, no cloud, no subscription."
    />
    <meta property="og:image" content="https://opal.palash.dev/assets/social-preview.png" />
    <meta property="og:image:alt" content="Opal's home screen, with a search box and a row of trending films" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@idebpalash" />
    <meta name="twitter:creator" content="@idebpalash" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </head>

  <body>
    <header class="hero">
      <!-- Photograph and scrim, both CSS. See the hero block in global.css. -->
      <div class="veil"></div>

      <!-- The nav sits inside the hero, on the photograph: no bar, no divider. -->
      <nav>
        <div class="wrap">
          <a class="brand" href="/"><img src="/assets/logo.svg" alt="" width="26" height="26" />Opal</a>
          <span class="spacer"></span>
          <a class="navlink hide-sm" href="#features">Features</a>
          <a class="navlink hide-sm" href="#why">Compare</a>
          <a class="navlink hide-md" href="#extension">Extension</a>
          <!-- Native disclosures: menus that need no JavaScript to open. -->
          <details class="menu hide-md">
            <summary class="navlink">More</summary>
            <div class="dlpanel">
              <a href={`${REPO}#readme`}><span class="os">📖</span><span class="grow">Docs<span class="meta">readme &amp; setup</span></span></a>
              <a href={`${REPO}/blob/main/CHANGELOG.md`}><span class="os">📝</span><span class="grow">Changelog<span class="meta">what changed</span></span></a>
              <a href={`${REPO}/releases`}><span class="os">🏷️</span><span class="grow">Releases<span class="meta">every version</span></span></a>
              <a href={`${REPO}/issues`}><span class="os">🐞</span><span class="grow">Issues<span class="meta">report a bug</span></span></a>
              <a href={X} rel="me"><span class="os">𝕏</span><span class="grow">Follow<span class="meta">@idebpalash</span></span></a>
            </div>
          </details>
          <details class="menu donate hide-sm">
            <summary class="navlink">Donate</summary>
            <div class="dlpanel">
              <a href="https://ko-fi.com/debpalash"><span class="os">☕</span><span class="grow">Ko-fi<span class="meta">one-off or monthly</span></span></a>
              <a href="https://paypal.me/palashCoder"><span class="os">💸</span><span class="grow">PayPal<span class="meta">direct</span></span></a>
              <a href={REPO}><span class="os">⭐</span><span class="grow">Or just star it<span class="meta">free, still helps</span></span></a>
            </div>
          </details>
          <StarButton client:load />
          <DownloadMenu client:load variant="nav" />
        </div>
      </nav>

      <div class="wrap">
        <img class="mark" src="/assets/logo.svg" alt="Opal logo" width="96" height="96" />
        <ReleaseBadge client:load />
        <h1>Play everything.<br />From one app.</h1>
        <p class="tagline">
          Movies, TV, anime, <b>live TV</b>, YouTube, torrents &amp; manga — plus
          your <b>Jellyfin &amp; Plex</b>.
        </p>
        <div class="cta">
          <DownloadMenu client:load />
          <StarButton client:load />
        </div>

        <div class="shot">
          <img
            src="/assets/home.png"
            alt="Opal's home screen: a time-aware greeting, an ask-anything search box, and a trending row of movies and shows"
            width="1600"
            height="1000"
            fetchpriority="high"
          />
        </div>
      </div>
    </header>

    <section id="features">
      <div class="wrap">
        <p class="eyebrow">What you get</p>
        <h2>One app instead of a stack</h2>

        <div class="grid">
          {
            features.map(([name, body]) => (
              <div class="card">
                <h3>{name}</h3>
                <p>{body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="alt">
      <div class="wrap">
        <div class="split">
          <div>
            <p class="eyebrow">Search</p>
            <h3>Ask once, get everything</h3>
            <p>
              One query fans out across every source you have enabled and comes
              back ranked — local files, swarms, your servers, the web.
            </p>
          </div>
          <div class="shot">
            <img
              src="/assets/search.png"
              alt="One query fanned out across every source, ranked, each row with a play button"
              loading="lazy"
            />
          </div>
        </div>

        <div class="split flip">
          <div class="shot">
            <img
              src="/assets/ask-the-ai.gif"
              alt="A suggestion chip answered by the local AI with a rail of playable posters"
              loading="lazy"
            />
          </div>
          <div>
            <p class="eyebrow">Copilot</p>
            <h3>A recommendation engine you own</h3>
            <p>
              It runs locally and can actually do things — search, queue, play.
              Your history is a SQLite file on your disk.
            </p>
          </div>
        </div>

        <div class="split" id="extension">
          <div>
            <p class="eyebrow">Browser extension</p>
            <h3>Opal Connect</h3>
            <p>
              Send the video in the tab you are on, add a manga site as a source
              in one click, and drive playback from a side panel.
            </p>
            <p class="aside">
              Chrome, Edge and Firefox — packed into
              <a href={`${REPO}/releases/latest`}>every release</a>.
            </p>
            <ExtensionDownloads client:load />
          </div>
          <div class="shot">
            <img
              src="/assets/extension-sidebar.png"
              alt="The Opal Connect side panel: connection status, page actions, transport controls and a live cross-source search"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <section id="why">
      <div class="wrap">
        <p class="eyebrow">Compare</p>
        <h2>Against the apps you already run</h2>
        <div class="tablewrap">
          <table class="matrix">
            <thead>
              <tr>
                <th>Capability</th>
                <th class="me">Opal</th>
                {rivals.map((r) => <th>{r}</th>)}
              </tr>
            </thead>
            <tbody>
              {
                matrix.map(([cap, ...cells]) => (
                  <tr>
                    <td>{cap}</td>
                    {cells.map((c, i) => (
                      <td class={`${i === 0 ? "me " : ""}${c === "—" ? "no" : ""}`}>{c}</td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="foot">
          “Add-ons” means available through third-party extensions rather than
          built in. Compiled from each project's own documentation — if something
          here is out of date, <a href={`${REPO}/issues`}>tell me</a> and I'll fix it.
        </p>
      </div>
    </section>

    <section class="cta" id="download">
      <div class="wrap">
        <p class="eyebrow">Get it</p>
        <h2>Download Opal</h2>
        <p class="sub">
          The one command detects your platform, verifies checksums, and doubles
          as the updater. Every format a release ships is below; the browser
          extension is <a href="#extension">up with Opal Connect</a>.
        </p>

        <InstallCommand client:load />
        <DownloadGrid client:load />

        <div class="note">
          macOS may call the <code>.dmg</code> “damaged” — it is not notarized;
          the installer skips that dialog, or run
          <code>sudo xattr -cr /Applications/Opal.app</code> once. On Windows,
          SmartScreen warns because the build is unsigned, and the platform is
          still <b>alpha</b>. Linux needs a glibc from 2022 or later.
        </div>

        <p class="metalinks">
          <a href={`${REPO}/releases/latest`}>Release notes</a>
          <a href={`${REPO}#readme`}>Docs</a>
          <a href={`${REPO}/issues`}>Report a bug</a>
          <a href={X} rel="me">Follow the build</a>
        </p>
      </div>
    </section>

    <section class="support">
      <div class="wrap">
        <div class="col">
          <p class="eyebrow">Support</p>
          <h2>Opal is free. Keeping it that way costs something.</h2>
          <p class="sub">
            No ads, no accounts, no telemetry, nothing to upsell you — so there
            is no revenue behind it either. If Opal saved you a subscription,
            put a bit of it back.
          </p>
          <div class="cta">
            <a class="btn primary" href="https://ko-fi.com/debpalash">Buy me a coffee</a>
            <a class="btn" href="https://paypal.me/palashCoder">PayPal</a>
            <StarButton client:load />
          </div>
          <p class="foot">
            Skint? Starring the repo, filing a good bug report or telling one
            person about it all help too.
          </p>
        </div>
      </div>
    </section>

    <footer>
      <div class="wrap">
        <div class="row">
          <a class="brand" href="/"><img src="/assets/logo.svg" alt="" width="26" height="26" />Opal</a>
          <span class="spacer" style="flex: 1"></span>
          <a href={REPO}>GitHub</a>
          <a href={X} rel="me">X</a>
          <a href={`${REPO}/releases`}>Releases</a>
          <a href={`${REPO}/issues`}>Issues</a>
          <a href="https://ko-fi.com/debpalash">Ko-fi</a>
          <a href="https://paypal.me/palashCoder">PayPal</a>
        </div>
        <p style="margin: 18px 0 0; font-size: 13px">
          GPL-3.0. Opal hosts no content and ships with no sources enabled.<br />
          Photographs by Nareeta Martin and FLY:D, via Unsplash.
        </p>
      </div>
    </footer>
  </body>
</html>
