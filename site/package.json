{
  "name": "opal-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "opal.palash.dev — the Opal landing page (Astro 7 + React islands, static, deployed to Cloudflare Pages).",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check:seo": "node scripts/check-seo.mjs",
    "test": "astro build && node scripts/check-seo.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "astro build && wrangler pages deploy dist --project-name opal"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "ogl": "^1.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.119.0"
  }
}
